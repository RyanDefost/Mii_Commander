MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1055140727}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c335e60e510a486c947c86b465f3d3ed, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Menu.TutorialScreen
  moveOutClip: {fileID: 7400000, guid: ed0601f46ddec65e6b220fd43edfd7b0, type: 2}
  moveInClip: {fileID: 7400000, guid: aa3ede1caa854fc6b81e926f97f69fa5, type: 2}
  tutorials:
  - videoClip: {fileID: 32900000, guid: 3f6195950cd6e84138422603bd7dbea1, type: 3}
    infoText: Grab Candy from the bag to place them on the board!
  - videoClip: {fileID: 32900000, guid: b95e3e4cc40ca0c61989d5f976373cd7, type: 3}
    infoText: When ready, press the NEXT button to move the candy down
  - videoClip: {fileID: 32900000, guid: 97e87d6af4235ec9298af0fef96a1398, type: 3}
    infoText: When candy reaches the bottom, they get added to your score
  - videoClip: {fileID: 32900000, guid: 6855f8392fa7d46219b0294b2064390b, type: 3}
    infoText: Items to help you can be bought from the shop on the right
  - videoClip: {fileID: 32900000, guid: 3ba2a45b734c06eada9996fb99c48102, type: 3}
    infoText: Items can be combined or split to increase their score!
  - videoClip: {fileID: 32900000, guid: 175d63c0cca486f95929ca016ce988eb, type: 3}
    infoText: Combiners and Splitters can be rotated by holding the right mouse button
      to be used in other directions
  - videoClip: {fileID: 32900000, guid: e612ee714e9ee7ce6806812d5f489c3d, type: 3}
    infoText: You can always check what synergies are available on the cheatSheet.!
  textElements:
  - {fileID: 264695763}
  - {fileID: 2003653291}
