/**
 * @mainpage Project Architecture Map
 * 
 * @htmlonly
 * <div id="download-container" style="margin-bottom: 20px; display: flex; gap: 10px;">
 *   <button id="btn-download-full" style="cursor:pointer; padding: 8px 12px; background-color: #4A6782; color: white; border: none; border-radius: 4px;">
 *     Download Full Architecture SVG
 *   </button>
 *   <button id="btn-download-public" style="cursor:pointer; padding: 8px 12px; background-color: #2E7D32; color: white; border: none; border-radius: 4px;">
 *     Download Public API SVG
 *   </button>
 * </div>
 *
 * <script>
 * document.addEventListener("DOMContentLoaded", function() {
 *     const downloadUml = (index, filename) => {
 *         // Select all UML images/objects on the page
 *         const umlImages = document.querySelectorAll('img[src^="inline_umlgraph"], object[data^="inline_umlgraph"]');
 *         
 *         if (umlImages[index]) {
 *             const umlImg = umlImages[index];
 *             const url = umlImg.src || umlImg.data;
 *             const link = document.createElement("a");
 *             link.href = url;
 *             link.download = filename;
 *             document.body.appendChild(link);
 *             link.click();
 *             document.body.removeChild(link);
 *         } else {
 *             alert("UML Diagram #" + (index + 1) + " not found on page.");
 *         }
 *     };
 *
 *     document.getElementById("btn-download-full").addEventListener("click", function() {
 *         downloadUml(0, "FullArchitecture.svg");
 *     });
 *
 *     document.getElementById("btn-download-public").addEventListener("click", function() {
 *         downloadUml(1, "PublicArchitecture.svg");
 *     });
 * });
 * </script>
 * @endhtmlonly
 * 
 * ---
 * 
 * ## Full Architecture
 * @startuml
 * !include full_project.puml
 * @enduml
 *
 * ---
 * 
 * ## Public API & Serialized Fields
 * @startuml
 * !include public_project.puml
 * @enduml
 *
 * ---
 * 
 * ## Desired project design
 * @startuml
 * !include desired_design.puml
 * @enduml
 */