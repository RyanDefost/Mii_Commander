/**
 * @mainpage Project Architecture Map
 * 
 * @htmlonly
 * <div id="download-container" style="margin-bottom: 20px;">
 *   <button id="btn-download-uml" style="cursor:pointer; padding: 8px 12px; background-color: #4A6782; color: white; border: none; border-radius: 4px;">
 *     Download PlantUML SVG
 *   </button>
 * </div>
 *
 * <script>
 * document.addEventListener("DOMContentLoaded", function() {
 *     const button = document.getElementById("btn-download-uml");
 *     button.addEventListener("click", function() {
 *         // Find the SVG or Image generated by the @startuml block
 *         // Doxygen usually puts it in an object or img tag
 *         const umlImg = document.querySelector('img[src^="inline_umlgraph"], object[data^="inline_umlgraph"]');
 *         
 *         if (umlImg) {
 *             const url = umlImg.src || umlImg.data;
 *             const link = document.createElement("a");
 *             link.href = url;
 *             link.download = "ProjectArchitecture.svg";
 *             document.body.appendChild(link);
 *             link.click();
 *             document.body.removeChild(link);
 *         } else {
 *             alert("UML Diagram not found on page.");
 *         }
 *     });
 * });
 * </script>
 * @endhtmlonly
 * 
 * @startuml
 * !include full_project.puml
 * @enduml
 */