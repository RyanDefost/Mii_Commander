104                 accelerationTarget, this.accelerationRate * dt\par
105             );\par
106 \par
107             {\cf20 // Apply sensitivity with depth and pixel density compensation}\par
108             {\cf18 float} depthScale = GetDepthScale();\par
109             {\cf18 float} effectiveSensitivity = this.baseSensitivity * this.pixelDensityScale * depthScale * this.currentSpeedMultiplier;\par
110 \par
111             Vector2 movement = delta * effectiveSensitivity;\par
112             Vector3 newPosition = this.transform.position + {\cf17 new} Vector3(movement.x, movement.y, 0f);\par
113 \par
