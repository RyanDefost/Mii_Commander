{
\pard\plain \s61\li360\sa60\sb30\qj\widctlpar\qj\adjustright \fs20\cgrid 
\par
{
{\s17\sa60\sb30\widctlpar\qj \fs22\cgrid 
Called from the input handler inside the {\b PlayerHandManager}. }}\par
{
\par
\pard\plain \s41\li360\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 91         \{\par
92             {\cf19 if} (delta.sqrMagnitude < 0.0001f)\par
93                 {\cf19 return};\par
94 \par
95             {\cf18 float} dt = GetSafeDeltaTime();\par
96             {\cf18 float} inputSpeed = delta.magnitude / dt;\par
97 \par
98             {\cf20 // Accelerate based on input intensity}\par
99             {\cf18 float} accelerationTarget = Mathf.Lerp(this.minSpeedMultiplier, this.maxSpeedMultiplier, \par
100                 Mathf.Clamp01(inputSpeed / 1000f)); {\cf20 // Normalize input speed}\par
101 \par
102             this.currentSpeedMultiplier = Mathf.MoveTowards(this.currentSpeedMultiplier,\par
103                 accelerationTarget, this.accelerationRate * dt\par
104             );\par
105 \par
106             {\cf20 // Apply sensitivity with depth and pixel density compensation}\par
107             {\cf18 float} depthScale = GetDepthScale();\par
108             {\cf18 float} effectiveSensitivity = this.baseSensitivity * this.pixelDensityScale * depthScale * this.currentSpeedMultiplier;\par
109 \par
110             Vector2 movement = delta * effectiveSensitivity;\par
111             Vector3 newPosition = this.transform.position + {\cf17 new} Vector3(movement.x, movement.y, 0f);\par
112 \par
113             {\cf20 // Clamp to bounds}\par
114             this.transform.position = ClampToBounds(newPosition);\par
115         \}\par
}
}
