93             {\cf19 if} (delta.sqrMagnitude < 0.0001f)\par
94                 {\cf19 return};\par
95 \par
96             {\cf18 float} dt = GetSafeDeltaTime();\par
97             {\cf18 float} inputSpeed = delta.magnitude / dt;\par
98 \par
99             {\cf20 // Accelerate based on input intensity}\par
